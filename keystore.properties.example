# Copy this file to `keystore.properties` and fill in your own values.
# `keystore.properties` is git-ignored — never commit real signing secrets.
#
# Generate a keystore first:
#   keytool -genkeypair -v -keystore keystore/smartspend-release.jks \
#     -alias smartspend -keyalg RSA -keysize 4096 -validity 10000
#
# Paths are resolved relative to the project root.

storeFile=keystore/smartspend-release.jks
storePassword=CHANGE_ME
keyAlias=smartspend
keyPassword=CHANGE_ME
